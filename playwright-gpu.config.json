{
  "//": "GPU Chrome launch flags for playwright-mcp. Mounted read-only and passed via --config. See TASK-368. Without these + the nvidia runtime + NVIDIA_DRIVER_CAPABILITIES=all, headless Chromium falls back to SwiftShader (software WebGL) and OOMs on heavy VRM scenes. contextOptions.storageState (TASK-1375, TASK-2409) seeds every --isolated context as user nick on dev.bawthub.com and the installed h1/h2/h3.bawthub.com previews (bawthub-subject cookie + bawthub-selected-user localStorage, format from bawthub frontend/src/lib/selectedUser.ts) so bots skip the TASK-1337 user picker. Cookies are exact-host only; app.bawthub.com and other hosts remain unseeded. Update the explicit host list when the house inventory changes. To test the picker itself, clear that cookie and localStorage key first. Single-file bind mount: verify the mounted content with docker exec llm-bawt-playwright-mcp cat /etc/playwright-gpu.json before restarting; an atomic file replacement may require recreating the mount.",
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "args": [
        "--ignore-gpu-blocklist",
        "--enable-gpu-rasterization",
        "--enable-zero-copy",
        "--use-angle=vulkan",
        "--enable-features=Vulkan"
      ]
    },
    "contextOptions": {
      "storageState": {
        "cookies": [
          {
            "name": "bawthub-subject",
            "value": "nick",
            "domain": "dev.bawthub.com",
            "path": "/",
            "expires": -1,
            "httpOnly": false,
            "secure": true,
            "sameSite": "Strict"
          },
          {
            "name": "bawthub-subject",
            "value": "nick",
            "domain": "h1.bawthub.com",
            "path": "/",
            "expires": -1,
            "httpOnly": false,
            "secure": true,
            "sameSite": "Strict"
          },
          {
            "name": "bawthub-subject",
            "value": "nick",
            "domain": "h2.bawthub.com",
            "path": "/",
            "expires": -1,
            "httpOnly": false,
            "secure": true,
            "sameSite": "Strict"
          },
          {
            "name": "bawthub-subject",
            "value": "nick",
            "domain": "h3.bawthub.com",
            "path": "/",
            "expires": -1,
            "httpOnly": false,
            "secure": true,
            "sameSite": "Strict"
          }
        ],
        "origins": [
          {
            "origin": "https://dev.bawthub.com",
            "localStorage": [
              {
                "name": "bawthub-selected-user",
                "value": "{\"v\":1,\"id\":\"nick\"}"
              }
            ]
          },
          {
            "origin": "https://h1.bawthub.com",
            "localStorage": [
              {
                "name": "bawthub-selected-user",
                "value": "{\"v\":1,\"id\":\"nick\"}"
              }
            ]
          },
          {
            "origin": "https://h2.bawthub.com",
            "localStorage": [
              {
                "name": "bawthub-selected-user",
                "value": "{\"v\":1,\"id\":\"nick\"}"
              }
            ]
          },
          {
            "origin": "https://h3.bawthub.com",
            "localStorage": [
              {
                "name": "bawthub-selected-user",
                "value": "{\"v\":1,\"id\":\"nick\"}"
              }
            ]
          }
        ]
      }
    }
  }
}
