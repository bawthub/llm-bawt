#!/bin/sh
# Choose which checkout this house's preview serves (TASK-2135). The house
# bridge runs the preview itself: it installs from the lockfile, then starts
# the normal Vite + Hono pair, and restarts it after any house restart.
# No migration, db push, schema change or backend app startup.
set -eu
if [ "$#" -ne 1 ] || [ ! -f "$1/package.json" ]; then
    printf '%s\n' 'usage: house-preview /absolute/task/worktree/frontend' >&2
    exit 2
fi
case "$1" in /*) ;; *) printf '%s\n' 'frontend path must be absolute' >&2; exit 2 ;; esac
: "${BAWT_HOUSE:?house-preview requires a house slot}"
exec python -m agent_bridge.house_preview_supervisor use "$1"
