#!/bin/sh
# git-credential-bawthub — provider-connect git credential helper.
#
# Asks the app for GitHub App credentials or the encrypted tenant PAT, and
# hands them directly to git. Nothing durable is stored on disk.
#
# Only the `get` operation is answered: `store` and `erase` are no-ops so git
# never caches a token that is about to expire.
#
# Enabled by configuring `credential.helper = bawthub`. The tenant stack does
# that via GIT_CONFIG_* env (bawthub deploy/compose/docker-compose.base.yml);
# on the dev host the
# helper ships inert so bridges keep using their SSH identity.
#
# The X-Bridge-Token gate value (TASK-1477), first non-empty of:
#   1. the contents of $BRIDGE_GIT_CREDENTIAL_TOKEN_FILE (the app's derived
#      token export), when readable;
#   2. $BRIDGE_GIT_CREDENTIAL_TOKEN (legacy, removed in phase 5);
#   3. none: the header is omitted entirely.
# The header goes to curl on stdin, never on its command line.
#
# Env:
#   LLM_BAWT_API_URL                   base URL of the app (default http://app:8642)
#   BRIDGE_GIT_CREDENTIAL_TOKEN_FILE   path of the derived gate token
#   BRIDGE_GIT_CREDENTIAL_TOKEN        legacy gate token
[ "$1" = get ] || exit 0

# A global helper may be asked about a foreign remote/submodule. Never give
# GitHub credentials to any other host, even if Git configuration is changed.
protocol=
host=
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0

token=
if [ -n "${BRIDGE_GIT_CREDENTIAL_TOKEN_FILE:-}" ] && [ -r "$BRIDGE_GIT_CREDENTIAL_TOKEN_FILE" ]; then
  token=$(tr -d ' \t\r\n' < "$BRIDGE_GIT_CREDENTIAL_TOKEN_FILE" 2>/dev/null) || token=
fi
[ -n "$token" ] || token="${BRIDGE_GIT_CREDENTIAL_TOKEN:-}"

url="${LLM_BAWT_API_URL:-http://app:8642}/v1/providers/github/git-credential?host=github.com"
if [ -n "$token" ]; then
  printf 'X-Bridge-Token: %s\n' "$token" | curl -fsS --max-time 15 -H @- "$url"
  exit $?
fi
exec curl -fsS --max-time 15 "$url" < /dev/null
