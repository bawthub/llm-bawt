# TASK-861: standalone stdlib-only worker. No app imports, package install, SSH,
# systemd, source bind mounts, DB credentials, or network access at runtime.
# Supply an operator-verified Python base image ID/digest already on the daemon.
# TASK-997: image_deploy.py is the stdlib-only digest deploy/rollback module the
# worker imports for the fixed deploy_image/rollback_image actions.
ARG OPS_PYTHON_BASE
FROM ${OPS_PYTHON_BASE}
COPY src/llm_bawt/ops/worker.py src/llm_bawt/ops/image_deploy.py src/llm_bawt/ops/routing_reconcile.py \
     src/llm_bawt/ops/compose_render.py src/llm_bawt/ops/compose_config.py src/llm_bawt/ops/config_reconcile.py \
     src/llm_bawt/ops/app_config_reconcile.py src/llm_bawt/ops/sealed_container.py \
     src/llm_bawt/ops/source_state.py src/llm_bawt/ops/service_identity.py \
     src/llm_bawt/ops/tagged_config_reconcile.py src/llm_bawt/ops/plan_reconcile.py \
     src/llm_bawt/ops/probe_contract.py src/llm_bawt/ops/container_remove.py \
     src/llm_bawt/ops/dev_config_reconcile.py src/llm_bawt/ops/restart_health.py /ops/
LABEL llm-bawt.ops.routing-reconcile="1"
# TASK-1518: this worker renders the target's Compose service, reconciles its
# configuration and refuses a deploy over configuration drift.
LABEL llm-bawt.ops.config-reconcile="1"
# TASK-1474: this worker reconciles a Compose-BUILT target (the llm-bawt app).
LABEL llm-bawt.ops.app-config-reconcile="1"
# TASK-1474: ...and refuses unless the app's bind-mounted source is exactly the
# approved commit (sealed git check, source_state.py).
LABEL llm-bawt.ops.app-source-guard="1"
# TASK-1474 step 4: ...with the v2 built profile (declared image, pull_policy and
# security_opt; health field/value), so the BawtHub backend is a second target.
LABEL llm-bawt.ops.built-profile-v2="1"
# TASK-1476: ...and the v3 process profile (healthcheck, tmpfs, a declared
# entrypoint) with the tagged-image kind (tagged_config_reconcile.py, crawl4ai).
LABEL llm-bawt.ops.process-profile-v3="1"
# TASK-1476: ...and runs an ordered multi-target service plan with the cutover
# probe contract (plan_reconcile.py, probe_contract.py).
LABEL llm-bawt.ops.service-plan-reconcile="1"
# TASK-1233: this worker enforces the quiesce start fence (worker.fence_expired).
LABEL llm-bawt.ops.quiesce-fence="1"
# TASK-1439 T2c: this worker removes ONE stopped Compose-orphan container
# (container_remove.py).
LABEL llm-bawt.ops.container-remove="1"
# TASK-1649: ...and reconciles a Compose-built DEV target with its memory cap
# (dev_config_reconcile.py, the BawtHub hot-reload frontend).
LABEL llm-bawt.ops.dev-config-reconcile="1"
# TASK-1697: ...and verifies a restart/start's in-container health URL afterwards
# (restart_health.py), so a service that never comes back fails the job.
LABEL llm-bawt.ops.restart-health="1"
ENTRYPOINT ["python3", "-I", "/ops/worker.py"]
