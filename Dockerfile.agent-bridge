# Shared agent-bridge image — no CUDA/GPU, just Python + bridge deps.
# Built once and run by every harness bridge (openclaw / claude-code / codex);
# see the `x-agent-bridge-image` anchor in docker-compose.yml.
FROM python:3.12-slim

# Tools grouped by purpose (one group per line):
#   core:       curl libpq5 openssh-client git git-lfs ca-certificates
#   data:       jq yq
#   search:     ripgrep fd-find
#   db clients: postgresql-client redis-tools sqlite3
#   sys/proc:   procps iproute2 less tree htop
#   net debug:  dnsutils iputils-ping netcat-openbsd rsync
#   archives:   unzip zip xz-utils
#   binary/file: file xxd (file type ID + hex dump for image/binary inspect)
#   build:      make shellcheck (Node/npm installed from verified upstream below)
#   editors:    vim
#   viewers:    bat (installed as batcat on Debian; symlinked to bat below)
#   package mgr: corepack (enabled below for pnpm)
#   (uv is installed below via official installer, not apt)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libpq5 openssh-client git git-lfs ca-certificates \
    jq yq \
    ripgrep fd-find \
    postgresql-client redis-tools sqlite3 \
    procps iproute2 less tree htop \
    dnsutils iputils-ping netcat-openbsd rsync \
    unzip zip xz-utils \
    file xxd \
    make shellcheck \
    vim \
    bat \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(which fdfind)" /usr/local/bin/fd \
    && ln -s "$(which batcat)" /usr/local/bin/bat

# Install uv to a shared prefix (not /root/.local, which the bridge user
# can't traverse) so both the build (root) and runtime (bridge) can use it.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
ENV PATH="/usr/local/bin:$PATH"

# TASK-1061: install one supported Node toolchain, not distro Node plus an
# overlay. Version and per-architecture checksums must be updated together from
# https://nodejs.org/dist/v24.21.0/SHASUMS256.txt. Fail closed on other arches.
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      amd64) node_arch=x64; node_sha=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6 ;; \
      arm64) node_arch=arm64; node_sha=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2 ;; \
      *) echo "unsupported Node architecture" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v24.21.0/node-v24.21.0-linux-${node_arch}.tar.xz" -o /tmp/node.tar.xz; \
    printf '%s  /tmp/node.tar.xz\n' "$node_sha" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner; \
    rm /tmp/node.tar.xz; \
    node --version; npm --version; npx --version

# Explicitly pin Corepack instead of relying on Node's bundled version (or
# presence). It supplies pnpm shims; the bridge user's cache is seeded below.
RUN npm install --global corepack@0.36.0 && corepack enable

# GitHub CLI via the official apt repo (always current; no pinned version to
# rot). Agents are told to use `gh` for PRs/issues — make it present.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Bitwarden CLI (OSS build — Vaultwarden-friendly). Used by agents to read
# secrets from vault.ferreri.us at runtime. Server URL is set per-user below
# (lands in /home/bridge/.config/Bitwarden CLI/data.json).
ARG BW_CLI_VERSION=2026.4.1
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) asset="bw-oss-linux-${BW_CLI_VERSION}.zip" ;; \
      arm64) asset="bw-oss-linux-arm64-${BW_CLI_VERSION}.zip" ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/bw.zip "https://github.com/bitwarden/clients/releases/download/cli-v${BW_CLI_VERSION}/${asset}"; \
    unzip -j /tmp/bw.zip bw -d /usr/local/bin; \
    chmod +x /usr/local/bin/bw; \
    rm /tmp/bw.zip; \
    /usr/local/bin/bw --version

# Shared agent scripts (bw-secret and friends) live in the agent-skills
# repo and are bind-mounted live at /opt/agent-skills/bin via compose.
# The directory is added to PATH below so they resolve without an absolute
# path. Editing a script in agent-skills/scripts is picked up instantly —
# no image rebuild needed. See agent-skills/scripts/README.md.

WORKDIR /app

# Copy project metadata for dependency resolution
COPY pyproject.toml ./

# Copy the full src tree.
# Previously this only copied the three bridge packages, but the editable
# `llm` CLI (installed via uv tool below) needs `llm_bawt` available too. The
# whole src/ is only ~6 MB — not worth the granular COPY complexity.
COPY src/ ./src/

# Minimal venv with only what bridges need. Preserve the verified Python
# environment during toolchain rebuilds; update constraints deliberately.
COPY docker/agent-bridge-constraints.txt /app/agent-bridge-constraints.txt
RUN uv venv && uv pip install --constraint /app/agent-bridge-constraints.txt \
    "redis[hiredis]>=5.0.0" \
    "sqlalchemy>=2.0" \
    "psycopg2-binary>=2.9" \
    "websockets>=13.0" \
    "httpx>=0.26.0" \
    "anyio>=4.0" \
    "claude-agent-sdk>=0.2.160" \
    "openai-codex-sdk>=0.1.11" \
    "openai>=1.69.0" \
    "fastapi>=0.109.0" \
    "uvicorn>=0.27.0" \
    "pydantic>=2.0" \
    "Pillow>=10.0.0" \
    "pyyaml>=6.0.2" \
    "tomlkit>=0.13.3"

# Live Codex model discovery (codex.models()) for the /models health-server route.
# Separate layer + --prerelease=allow because openai-codex (beta) pulls the
# prerelease openai-codex-cli-bin; kept out of the main install so it can't drag
# the stable set toward prereleases. Import name openai_codex — coexists with the
# openai-codex-sdk runtime above (import openai_codex_sdk).
RUN uv pip install --constraint /app/agent-bridge-constraints.txt --prerelease=allow "openai-codex>=0.1.0b3"

# Install project in editable mode so both bridge packages are importable
RUN uv pip install -e . --no-deps

# Keep the hand-curated bridge venv honest: editable installation deliberately
# skips project dependencies, so bridge-only imports must be verified here.
RUN .venv/bin/python -c "import tomlkit, yaml"

RUN useradd -m -s /bin/bash bridge && chown -R bridge:bridge /app
# Pre-create the bridge-owned dirs the compose files mount over, so both
# mount kinds inherit correct ownership:
#   ~/.codex  - bind mounts inherit the parent dir's ownership; without this the
#               codex CLI can't write cache/log/history alongside the
#               bind-mounted auth.json and config.toml.
#   ~/dev     - agent workspace (shared read-only with the frontend /repos viewer).
#   ~/.claude - Claude Code bridge state (sessions, settings, skills symlink).
# A NAMED volume seeds itself from the image path on first mount, so these must
# exist with bridge:bridge ownership at build time or the tenant stack comes up
# with root-owned, unwritable dirs.
RUN mkdir -p /home/bridge/.codex /home/bridge/dev /home/bridge/.claude \
    && chown bridge:bridge /home/bridge/.codex /home/bridge/dev /home/bridge/.claude

# TASK-835: provider-connect git credential helper, baked instead of
# hand-installed. It used to be `docker exec`'d into a running container by
# `tenant.sh bridge-git-setup`, which meant every fresh tenant started with
# broken git until someone SSH'd in. Shipping it in the image makes git auth
# zero-touch.
#
# The script is INERT on its own — git only calls it once `credential.helper`
# names it. The tenant stack turns it on via GIT_CONFIG_* env (see
# docker-compose.prod.yml); dev bridges keep using their mounted SSH identity
# and are unaffected by this layer.
COPY docker/git-credential-bawthub /usr/local/bin/git-credential-bawthub
RUN chmod 0755 /usr/local/bin/git-credential-bawthub

USER bridge

# uv tool-installed `llm` CLI (editable, full deps).
# Mirrors `make install` — gives the bridge user a working `llm` command
# in an isolated env at ~/.local/share/uv/tools/llm-bawt while keeping
# /app/.venv lean (bridge runtime deps only). Editable means changes to
# /app/src (bind-mounted in dev) are picked up without reinstall.
# The CLI imports httpx directly; newer provider SDKs no longer supply it
# transitively. Include it explicitly in this separate tool environment.
RUN uv tool install --force --editable /app --with "httpx==0.28.1"

# /home/bridge/.local/bin first so uv tool `llm` shadows the dep-less stub
# in /app/.venv/bin. `python` still resolves to /app/.venv/bin/python,
# so `python -m openclaw_bridge` etc. continue to use the bridge venv.
# /opt/agent-skills/bin holds bind-mounted scripts from the agent-skills
# repo (see agent-skills/scripts/README.md); this is intentionally last
# so agent helpers never shadow the project's own binaries.
ENV PATH="/home/bridge/.local/bin:/app/.venv/bin:$PATH:/opt/agent-skills/bin" \
    PYTHONUNBUFFERED=1 \
    HOME=/home/bridge \
    PYTHONDONTWRITEBYTECODE=1

# Point the Bitwarden CLI at our self-hosted Vaultwarden. Writes to
# ~/.config/Bitwarden CLI/data.json; baked here so containers start
# pre-configured (override at runtime with `bw config server <url>`).
ARG BW_SERVER_URL=https://vault.ferreri.us
RUN bw config server "$BW_SERVER_URL"

# Match BawtHub's packageManager; seed as bridge, not root, so first use needs
# neither elevated permissions nor a download. Repos can still select a version.
RUN corepack install --global pnpm@10.32.1
COPY docker/test-agent-bridge-toolchain.sh /usr/local/libexec/test-agent-bridge-toolchain.sh
RUN sh /usr/local/libexec/test-agent-bridge-toolchain.sh

# Default command — overridden per service in docker-compose.yml
CMD ["python", "-m", "openclaw_bridge"]
