# CPU embeddings image for tenants (TASK-2448).
#
# Runs the local-model-bridge in embed-only mode (LOCAL_MODEL_BRIDGE_EMBED_ONLY=1):
# sentence-transformers all-MiniLM-L6-v2 (384-dim) on CPU, no GPU, no chat
# engine. bawthub deploy/compose/docker-compose.embeddings.yml runs it as the
# tenant's `local-model-bridge` service so memory gets vector search without
# echo's GPU data plane.
#
# Same base and locked project deps as Dockerfile.app-cpu. torch comes from
# PyTorch's CPU wheel index at the uv.lock version instead of the default
# PyPI wheel, which pulls the multi-GB CUDA runtime on amd64. The model is
# baked in so first boot needs no Hugging Face download.
FROM python:3.12-slim

ARG SOURCE_SHA=unknown
LABEL org.opencontainers.image.revision="${SOURCE_SHA}"

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 libgomp1 curl ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"
ENV UV_HTTP_TIMEOUT=600 \
    UV_NO_CACHE=1

WORKDIR /app
COPY pyproject.toml setup.cfg uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --extra service

# Versions match uv.lock; keep them in step when the lock moves.
ARG TORCH_VERSION=2.13.0
ARG SENTENCE_TRANSFORMERS_VERSION=5.2.3
ARG TRANSFORMERS_VERSION=5.19.0
RUN uv pip install --python /app/.venv/bin/python \
        --index-url https://download.pytorch.org/whl/cpu "torch==${TORCH_VERSION}" \
    && uv pip install --python /app/.venv/bin/python \
        "sentence-transformers==${SENTENCE_TRANSFORMERS_VERSION}" \
        "transformers==${TRANSFORMERS_VERSION}"

COPY src/ ./src/
RUN uv sync --locked --no-dev --inexact --extra service

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    LOCAL_MODEL_BRIDGE_EMBED_ONLY=1 \
    LOCAL_MODEL_EMBED_DEVICE=cpu \
    LOCAL_MODEL_EMBED_MODEL=all-MiniLM-L6-v2

ARG EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
RUN python -c "from sentence_transformers import SentenceTransformer as S; \
m = S('${EMBED_MODEL_ID}', device='cpu'); \
assert m.get_sentence_embedding_dimension() == 384"

EXPOSE 8683 8684
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8683/health || exit 1
CMD ["python", "-m", "local_model_bridge"]
