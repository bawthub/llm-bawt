#!/usr/bin/env bash
# compose-secrets: run `docker compose` for a project whose bootstrap secrets
# live in the root-owned Docker volume llm-bawt-compose-secrets (TASK-2386).
#
#   scripts/compose-secrets [--project-dir DIR] -- <docker compose args...>
#   e.g. scripts/compose-secrets -- up -d --no-deps --no-build ops-reconciler
#
# The values never reach this shell, its argv or any host file. Compose runs in
# the pinned docker CLI image (the ops renderer's) with only this project's
# declared names mounted read-only, one volume subpath each, and reads them as
# extra --env-file inputs after the project's own .env, exactly as the ops
# renderer does. The project directory keeps its host path, so container
# labels (config_files, working_dir) match what the ops reconcilers expect.
#
# Without the volume (a fresh tenant, or before the rollout writes it) this is
# plain `docker compose "$@"`, so existing behavior is unchanged.
set -euo pipefail

IMAGE="${COMPOSE_SECRETS_IMAGE:-docker.io/library/docker@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d}"
VOLUME="${COMPOSE_SECRETS_VOLUME:-llm-bawt-compose-secrets}"  # override only for tests
SECRETS_DIR=/run/compose-secrets

dir="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    --project-dir) dir="$2"; shift 2 ;;
    --) shift; break ;;
    *) echo "usage: compose-secrets [--project-dir DIR] -- <docker compose args>" >&2; exit 2 ;;
  esac
done
dir="$(cd "$dir" && pwd -P)"

if ! docker volume inspect "$VOLUME" >/dev/null 2>&1; then
  cd "$dir" && exec docker compose "$@"
fi

# Each project receives only its own names (== compose_render.COMPOSE_SECRET_NAMES).
if [ -d "$dir/src/llm_bawt" ]; then
  # DATABASE_URL: BawtHub's, for the house previews (houses.compose.json);
  # no other llm-bawt service declares it.
  names=(LLM_BAWT_SECRET_KEY LLM_BAWT_POSTGRES_PASSWORD POSTGRES_PASSWORD DATABASE_URL)
  # TASK-2379: Redis AUTH names are optional; mount them only once written,
  # because a volume subpath that doesn't exist fails the whole run.
  present=" $(docker run --rm -v "$VOLUME:/s:ro" --entrypoint ls "$IMAGE" /s 2>/dev/null | tr '\n' ' ') "
  for name in LLM_BAWT_REDIS_PASSWORD LLM_BAWT_REDIS_URL; do
    case "$present" in *" $name.env "*) names+=("$name") ;; esac
  done
elif [ -d "$dir/frontend" ] && [ -f "$dir/docker-compose.yml" ]; then
  names=(DATABASE_URL)
else
  echo "compose-secrets: $dir is neither an llm-bawt nor a bawthub checkout" >&2; exit 2
fi

args=(--rm -w "$dir" -v /var/run/docker.sock:/var/run/docker.sock -v "$dir:$dir:ro")
# Compose files outside the project dir (e.g. the house pool's houses.compose.json,
# named by -f or COMPOSE_FILE) must be visible too: mount each one's directory
# read-only at its host path, which also covers sibling env_files.
compose_files=()
prev=""
for a in "$@"; do
  case "$prev" in -f|--file) compose_files+=("$a") ;; esac
  case "$a" in --file=*) compose_files+=("${a#--file=}") ;; esac
  prev="$a"
done
if [ ${#compose_files[@]} -eq 0 ]; then
  cf="${COMPOSE_FILE:-}"
  [ -z "$cf" ] && [ -f "$dir/.env" ] && cf="$(sed -n 's/^COMPOSE_FILE=//p' "$dir/.env" | tail -n 1)"
  IFS="${COMPOSE_PATH_SEPARATOR:-:}" read -r -a compose_files <<< "$cf"
fi
extra_dirs=" "
for f in "${compose_files[@]}"; do
  [ -n "$f" ] || continue
  case "$f" in /*) ;; *) f="$dir/$f" ;; esac
  d="$(cd "$(dirname "$f")" 2>/dev/null && pwd -P)" || continue  # compose reports the missing file
  case "$d/" in "$dir"/*) continue ;; esac
  case "$extra_dirs" in *" $d "*) continue ;; esac
  extra_dirs+="$d "
  args+=(-v "$d:$d:ro")
done
for name in "${names[@]}"; do
  args+=(--mount "type=volume,src=$VOLUME,dst=$SECRETS_DIR/$name.env,volume-subpath=$name.env,readonly")
done
# Forward the caller's environment by NAME (docker reads each value from this
# process, never argv), so shell-set interpolation still works. The secret
# names are never forwarded: their only source is the volume.
skip=" PATH HOSTNAME PWD OLDPWD SHLVL _ TERM ${names[*]} "
for name in $(compgen -e); do
  case "$skip" in *" $name "*) continue ;; esac
  args+=(-e "$name")
done
if [ -d "${HOME:-/nonexistent}/.docker" ]; then
  args+=(-v "$HOME/.docker:$HOME/.docker:ro" -e "DOCKER_CONFIG=$HOME/.docker")
fi
# Always forward stdin, like plain `docker compose` (piped input to `exec -T`/`run -T`).
args+=(-i)
[ -t 1 ] && args+=(-t)

env_files=()
[ -f "$dir/.env" ] && env_files+=(--env-file "$dir/.env")
for name in "${names[@]}"; do env_files+=(--env-file "$SECRETS_DIR/$name.env"); done

exec docker run "${args[@]}" --entrypoint docker "$IMAGE" compose "${env_files[@]}" "$@"
