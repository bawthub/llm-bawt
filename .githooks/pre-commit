#!/bin/sh
# TASK-1275: direct commits belong in the owner's task worktree, not the
# canonical checkout that live services read. This is a cooperative backstop;
# alternate commit paths are prohibited by git-commits rules (TASK-1823).
# bawt-wt-task-path-v1: legacy and task-qualified owner paths are guarded.
set -eu

canonical=$(git config --get branch.canonical || true)
if [ -z "$canonical" ]; then
    printf '%s\n' '✗ pre-commit: branch.canonical is not configured.' >&2
    exit 1
fi

git_dir=$(git rev-parse --path-format=absolute --git-dir)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
if [ "$git_dir" = "$common_dir" ]; then
    printf '%s\n' '✗ pre-commit: direct git commit in the shared canonical checkout is refused.' >&2
    printf '%s\n' '  Start your task with bawt-wt and commit in its worktree instead.' >&2
    exit 1
fi

repo=$(basename "$(dirname "$common_dir")")
worktree=$(basename "$(git rev-parse --show-toplevel)")
prefix=".wt-$repo-"
owner=
worktree_task=
case "$worktree" in
    "$prefix"*)
        suffix=${worktree#"$prefix"}
        case "$suffix" in
            *-TASK-*)
                owner=${suffix%-TASK-*}
                worktree_task=TASK-${suffix##*-TASK-}
                if ! printf '%s\n' "$worktree_task" | grep -Eq '^TASK-[1-9][0-9]*$'; then
                    owner=
                fi ;;
            *) owner=$suffix ;;
        esac ;;
esac
case "$owner" in
    ''|*[!a-z0-9-]*|-*|*-) owner= ;;
esac

branch=$(git symbolic-ref --short -q HEAD || true)
if [ -z "$branch" ]; then
    # Git temporarily detaches HEAD while replaying a task branch. A user
    # resolving a rebase conflict may legitimately run git commit there.
    for state in rebase-merge rebase-apply; do
        if [ -f "$git_dir/$state/head-name" ]; then
            IFS= read -r ref < "$git_dir/$state/head-name" || true
            case "$ref" in refs/heads/*) branch=${ref#refs/heads/} ;; esac
            break
        fi
    done
fi

task_pattern=${worktree_task:-TASK-[1-9][0-9]*}
if [ -z "$owner" ] || [ "$branch" = "$canonical" ] ||
   ! printf '%s\n' "$branch" | grep -Eq "^${owner}/${task_pattern}-[a-z0-9]+(-[a-z0-9]+)*$"; then
    printf '%s\n' '✗ pre-commit: commit only on your own task branch in .wt-<repo>-<bot>[-TASK-N].' >&2
    printf '  worktree: %s  owner: %s  task: %s  branch: %s\n' "$worktree" "${owner:-unknown}" "${worktree_task:-legacy}" "${branch:-detached}" >&2
    exit 1
fi
