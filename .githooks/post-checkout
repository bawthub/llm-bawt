#!/bin/sh
# TASK-1275: warn on branch switches in the shared checkout, not on a
# legitimate task branch in a linked worktree. Checkout itself cannot block.
[ "$3" = "1" ] || exit 0

git_dir=$(git rev-parse --path-format=absolute --git-dir) || exit 1
common_dir=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1
canonical=$(git config --get branch.canonical) || exit 1
current=$(git symbolic-ref --short -q HEAD || printf 'detached')

if [ "$git_dir" = "$common_dir" ] && [ "$current" != "$canonical" ]; then
    printf '\n⚠️  Shared checkout switched to %s (canonical: %s).\n' "$current" "$canonical" >&2
    printf '%s\n' '    Live services read this tree. Return it to canonical; direct commits are refused.' >&2
fi
